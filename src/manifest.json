{
  "manifest_version": 3,
  "name": "sf-releaselens",
  "version": "0.5.2",
  "description": "Release dashboard, metadata inspector and approvals helper for Salesforce release managers.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "identity"
  ],
  "optional_host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.my.salesforce.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "action": {
    "default_title": "Open sf-releaselens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
